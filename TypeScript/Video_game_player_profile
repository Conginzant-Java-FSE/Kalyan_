
type Rank = "Bronze" | "Silver" | "Gold" | "Platinum";


type Player = {
  username: string;
  level: number;
  experiencePoints: number;
  rank: Rank;
};


const player1: Player = {
  username: "ShadowHunter",
  level: 5,
  experiencePoints: 2500,
  rank: "Silver"
};

const player2: Player = {
  username: "DragonSlayer",
  level: 10,
  experiencePoints: 8000,
  rank: "Gold"
};


function promotePlayer(player: Player): Player {
  return {
    ...player,
    level: player.level + 1,
    experiencePoints: player.experiencePoints + 1000
  };
}


const updatedPlayer1 = promotePlayer(player1);
const updatedPlayer2 = promotePlayer(player2);

console.log(updatedPlayer1);
console.log(updatedPlayer2);
