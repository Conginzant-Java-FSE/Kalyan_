
interface Team {
  readonly id: number;
  name: string;
  players: string[];
  points: number;
}


const teams: Team[] = [
  { id: 1, name: "Warriors", players: ["Alex", "John"], points: 10 },
  { id: 2, name: "Dragons", players: ["Sam", "Chris"], points: 15 },
  { id: 3, name: "Titans", players: ["Mike", "David"], points: 8 }
];


function addPoints(team: Team, points: number): Team {
  return {
    ...team,
    points: team.points + points
  };
}

const updatedTeam = addPoints(teams[0], 5);
console.log(updatedTeam);


