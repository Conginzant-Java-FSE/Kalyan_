function decodeSecret(message: string): string {
  const vowelMap: Record<string, string> = {
    "4": "a",
    "3": "e",
    "1": "i",
    "0": "o",
    "8": "u"
  };

  return message.replace(/[43108]/g, (char) => vowelMap[char] || char);
}


